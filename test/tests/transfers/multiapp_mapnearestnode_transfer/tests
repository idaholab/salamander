[Tests]
  design = 'BlanketProblem.md MultiAppMapNearestNodeTransfer.md'
  issues = '#112'
  [transfer]
    requirement = 'The system shall be able to transfer field data between a 3D main application
                   and a 1D thermal hydraulics sub-application using a nearest-node search'
    [trans_multiapp]
      type = 'RunApp'
      input = 'transfer_interface.i'
      detail = 'across an interface boundary, and'
    []
    [trans_per]
      type = 'RunApp'
      input = 'transfer_per.i'
      detail = 'across an interface boundary when the boundary is periodic.'
      # Periodic system throws warning about not being able to find matching boundaries. This might
      # be due to the fact that the boundaries are orthogonal (as is required by the system), but
      # not facing one another. This is due to some bug in MOOSE, and new warnings were added to
      # capture it - see idaholab/moose#22496.
      allow_warnings = true
    []
  []
[]
