[Tests]
  design = 'cad_workflow.md'
  issues = '#30'
  [solid_diff_heavy]
    type = CSVDiff
    input = solid.i
    csvdiff = 'solid_out.csv'
    # This test has very few particles, and OpenMC will error if there aren't enough source particles
    # in the fission bank on a process
    max_parallel = 8
    mesh_mode = 'replicated'
    requirement = "The system shall be able to run a coupled neutronics with photon transport and heat conduction simulation,"
                   " and the heat source shall be extracted and normalized correctly from OpenMC."
    heavy = true
    min_slots = 3 # 884 MB per slot observed during https://civet.inl.gov/job/4323355/ during step Test heavy. Usage is over or within 100 MB of the total memory limit based on a 400 MB per slot limit.
  []
  [openmc_diff_heavy]
    type = CSVDiff
    input = solid.i
    csvdiff = 'solid_out_openmc0.csv'
    should_execute = False
    prereq = solid_diff_heavy
    # This test has very few particles, and OpenMC will error if there aren't enough source particles
    # in the fission bank on a process
    max_parallel = 8
    mesh_mode = 'replicated'
    requirement = "The system shall be able to run a coupled neutronics with photon transport and heat conduction simulation"
                  " and solve for the heat source and tritium production."
    heavy = true
  []
[]
